@startuml
title Fluxo de Funcionamento e Busca de Via - TVM 430

' ==========================================
' ESTILIZAÇÃO MODERNA (SINTAXE CSS / <style>)
' ==========================================
<style>
sequenceDiagram {
    RoundCorner 8
    ParticipantPadding 20
    BoxPadding 15
    
    FontName "Segoe UI", "Helvetica", "Arial"
    FontColor #1E293B
    LineColor #64748B
    
    actor {
        BackgroundColor #F1F5F9
        LineColor #1E293B
    }
    
    participant {
        BackgroundColor #EFF6FF
        LineColor #2563EB
        FontColor #1E293B
    }
    
    lifeLine {
        BackgroundColor #F8FAFC
        LineColor #94A3B8
    }
    
    arrow {
        LineColor #3B82F6
        FontColor #475569
        FontSize 12
    }
    
    box {
        BackgroundColor #F8FAFC
        LineColor #CBD5E1
